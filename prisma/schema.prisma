generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User authentication
model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  password              String
  emailVerified         DateTime?
  name                  String?
  phone                 String?
  role                  UserRole    @default(CUSTOMER)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer              Customer?
  admin                 Admin?
  orders                Order[]
  reviews               Review[]
  loyaltyAccount        LoyaltyAccount?
  sessions              Session[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// Customer profile
model Customer {
  id                    String      @id @default(cuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Delivery info
  deliveryName          String?
  deliveryPhone         String?
  deliveryAddress       String?
  deliveryCity          String?
  deliveryState         String?
  deliveryPostalCode    String?
  
  // Stats
  totalOrders           Int         @default(0)
  totalSpent            Float       @default(0)
  lastOrderDate         DateTime?
  status                CustomerStatus @default(ACTIVE)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// Admin profile
model Admin {
  id                    String      @id @default(cuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permissions           String[]    @default([])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
}

// Product categories
model Category {
  id                    String      @id @default(cuid())
  name                  String      @unique
  slug                  String      @unique
  description           String?
  enabled               Boolean     @default(true)
  displayOrder          Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  products              Product[]

  @@index([enabled])
  @@index([displayOrder])
}

// Products
model Product {
  id                    String      @id @default(cuid())
  name                  String
  slug                  String      @unique
  description           String?
  price                 Float
  cost                  Float?      // For admin analytics
  stock                 Int
  category              Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId            String
  
  // Media
  imageUrl              String?
  imagePublicId         String?     // For Cloudinary
  
  // Product details
  ingredients           String?     // For food spices
  featured              Boolean     @default(false)
  enabled               Boolean     @default(true)
  
  // Stats
  views                 Int         @default(0)
  purchases             Int         @default(0)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  orderItems            OrderItem[]
  reviews               Review[]
  campaignProducts      CampaignProduct[]

  @@index([categoryId])
  @@index([featured])
  @@index([enabled])
  @@index([slug])
}

// Orders
model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique // Human-readable order ID
  user                  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                String
  
  // Customer info at time of order
  customerName          String
  customerEmail         String
  customerPhone         String
  
  // Delivery
  deliveryAddress       String
  deliveryCity          String
  deliveryState         String
  deliveryPostalCode    String?
  
  // Order details
  items                 OrderItem[]
  subtotal              Float
  shippingCost          Float       @default(0)
  discountAmount        Float       @default(0)
  discountCode          String?
  total                 Float
  
  // Status
  status                OrderStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         String?     // e.g., "bank_transfer", "card", "cash_on_delivery"
  paymentReference      String?     // Transaction ID
  
  // Timeline
  confirmedAt           DateTime?
  processingAt          DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  
  notes                 String?     // Admin notes
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([orderNumber])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Order line items
model OrderItem {
  id                    String      @id @default(cuid())
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  
  product               Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId             String
  
  // Item snapshot at order time
  productName           String
  productPrice          Float
  quantity              Int
  subtotal              Float
  
  createdAt             DateTime    @default(now())

  @@index([orderId])
  @@index([productId])
}

// Product reviews
model Review {
  id                    String      @id @default(cuid())
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId             String
  
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  
  rating                Int         // 1-5
  title                 String?
  content               String?
  
  approved              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([approved])
}

// Customer loyalty
model LoyaltyAccount {
  id                    String      @id @default(cuid())
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String      @unique
  
  balance               Int         @default(0) // Points
  tier                  LoyaltyTier @default(BRONZE)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  transactions          LoyaltyTransaction[]

  @@index([userId])
  @@index([tier])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// Loyalty point transactions
model LoyaltyTransaction {
  id                    String      @id @default(cuid())
  account               LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId             String
  
  amount                Int         // Can be negative
  type                  String      // "purchase", "reward", "redemption", "adjustment"
  description           String?
  
  createdAt             DateTime    @default(now())

  @@index([accountId])
  @@index([type])
}

// Discount codes
model DiscountCode {
  id                    String      @id @default(cuid())
  code                  String      @unique
  
  type                  DiscountType
  value                 Float       // Percentage or fixed amount
  maxUses              Int?        // Null = unlimited
  usedCount            Int         @default(0)
  
  minOrderAmount        Float       @default(0)
  maxDiscount           Float?      // Max discount amount if percentage
  
  activeFrom            DateTime    @default(now())
  activeUntil           DateTime?
  enabled               Boolean     @default(true)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([code])
  @@index([enabled])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Marketing campaigns
model Campaign {
  id                    String      @id @default(cuid())
  name                  String
  slug                  String      @unique
  description           String?
  
  type                  CampaignType
  imageUrl              String?
  imagePublicId         String?
  
  products              CampaignProduct[]
  
  startDate             DateTime    @default(now())
  endDate               DateTime?
  enabled               Boolean     @default(true)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([enabled])
  @@index([type])
}

enum CampaignType {
  PROMOTION
  SEASONAL
  FLASH_SALE
  NEW_PRODUCT
}

model CampaignProduct {
  id                    String      @id @default(cuid())
  campaign              Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId            String
  
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId             String
  
  displayOrder          Int         @default(0)

  @@unique([campaignId, productId])
  @@index([campaignId])
}

// Contact form messages
model ContactMessage {
  id                    String      @id @default(cuid())
  name                  String
  email                 String
  phone                 String?
  subject               String
  message               String
  
  read                  Boolean     @default(false)
  archived              Boolean     @default(false)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([read])
  @@index([archived])
  @@index([createdAt])
}

// NextAuth sessions
model Session {
  id                    String      @id @default(cuid())
  sessionToken          String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  expires               DateTime
  
  createdAt             DateTime    @default(now())

  @@index([userId])
}

// Verification tokens for password reset, email verification
model VerificationToken {
  id                    String      @id @default(cuid())
  email                 String
  token                 String      @unique
  type                  String      // "email_verification", "password_reset"
  expires               DateTime
  
  createdAt             DateTime    @default(now())

  @@unique([email, type])
  @@index([token])
}
